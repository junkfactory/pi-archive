{
	"name": "pi-archive",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"description": "Pi extension that auto-archives stale sessions and browses archived sessions in a /pi-archive picker",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check ."
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^26.4.1",
		"typescript": "^5.8.0",
		"vitest": "^5.0.3"
	}
}
